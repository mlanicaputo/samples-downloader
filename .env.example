# Copy to .env and fill in. .env is gitignored; this template is not.
# Real environment variables take precedence over anything set here, so
# `SAMPLES_DIR=/tmp/x make pull` still works for a one-off.

# Required. Spotify developer dashboard -> your app -> Settings.
# The app must be in dev mode, or have your user added to its allowlist,
# or client_credentials will not be able to read the playlist.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Optional. Defaults shown.
# SPOTIFY_PLAYLIST_ID=1wmSX8uXxNxYhZUw5YR3CN
# SAMPLES_DIR=/Users/milo/Music/Logic/samples

# Optional. Fraction of the Spotify duration a YouTube result may differ by.
# Lower is stricter. 0.15 = 15%.
# DURATION_TOLERANCE=0.15

# Optional. Only consider tracks added to the playlist after this ISO date.
# ADDED_AFTER=2024-01-01T00:00:00Z
